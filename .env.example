# Application Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Configuration
DB_HOST=postgres
DB_PORT=5433
DB_PORT_HOST=5434
DB_USER=rocket
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION
DB_NAME=rocket

# JWT Configuration
# ⚠️ CRITICAL: Change this secret in production!
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_IN_PRODUCTION_USE_OPENSSL_RAND_BASE64_64
JWT_EXPIRATION=24h
JWT_AUDIENCE=rocketstarter_front
JWT_ISSUER=rocketstarter_api
ACCESS_TOKEN_TYPE=Bearer
ACCESS_TOKEN_ALGORITHM=HS256

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Cookie Domain (uncomment and set in production)
# COOKIE_DOMAIN=.votre-domaine.com
